{
  "name": "next-roots-example",
  "version": "1.0.0",
  "description": "Example of using next-roots package",
  "author": "Jirka Svoboda",
  "license": "MIT",
  "private": true,
  "scripts": {
    "preinstall": "pnpm -w build:no-test",
    "roots": "node ./../../dist/cli.js",
    "dev": "pnpm roots && next dev",
    "build": "pnpm roots && next build",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "e2e": "start-server-and-test dev http://localhost:3000 \"cypress open --e2e\"",
    "e2e:headless": "start-server-and-test dev http://localhost:3000 \"cypress run --e2e\""
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "next-roots": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "cypress": "^16.3.0",
    "esbuild": "^0.28.2",
    "esbuild-node-externals": "^2.0.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "postcss": "^8.5.33",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
